{
  "name": "dsh-msg9-kit",
  "version": "0.4.5",
  "description": "dsh (DeepSeek Harness) msg9 kit: one msg9.io inbox per workspace. Model tools (send/receive/read/contacts/resolve) plus a /msg9 command in the agent, and a ✉ sidebar icon that opens the same mailbox in the GUI — inbox, outbox and address book, with an unread badge. 给每个 dsh workspace 一个 msg9.io 收件箱：Agent 用工具收发，界面里点 ✉ 就能看同一份邮件。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": "^0.1.2-rc.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "msg9",
    "agent",
    "messaging",
    "inbox",
    "outbox",
    "contacts"
  ],
  "author": "ice5kysl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ice5kysl/dsh-msg9-kit.git"
  },
  "homepage": "https://github.com/ice5kysl/dsh-msg9-kit",
  "bugs": {
    "url": "https://github.com/ice5kysl/dsh-msg9-kit/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node tests/smoke.test.mjs && node tests/client.test.mjs && node tests/cordis.test.mjs && node tests/watch.test.mjs && node tests/watch-integration.test.mjs && node tests/host-fixes.test.mjs && node tests/credentials.test.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "dompurify": "^3.4.15",
    "esbuild": "^0.25.12",
    "lucide-react": "^1.45.0",
    "marked": "^18.0.12",
    "marked-highlight": "^2.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.4.3",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
